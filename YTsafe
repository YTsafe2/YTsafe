document.addEventListener("change",e=>{const i=e.target.id;if(i=="sort"){S.sort=e.target.value;draw()}else if(i=="f_ver"||i=="f_mon"){S.f[i.slice(2)]=e.target.checked;draw()}else if(i&&i.startsWith("f_")){S.f[i.slice(2)]=e.target.value;draw()}else if(i=="s_img"){$("prev").innerHTML=[...e.target.files].slice(0,4).map(f=>`<img src="${URL.createObjectURL(f)}">`).join("")}});
document.addEventListener("keydown",e=>{if(e.key!="Enter")return;const i=e.target.id||"";if(i=="q")A.qgo();else if(i=="le"||i=="lp")A.login();else if(i.startsWith("mi_"))A.send({id:i.slice(3)})});
const need=()=>{if(S.u)return false;go("auth");T("Please sign in first");return true};
const comp=(f,W,Q)=>new Promise(res=>{const r=new FileReader();r.onload=()=>{const i=new Image();i.onload=()=>{const k=Math.min(1,W/i.width),c=document.createElement("canvas");c.width=i.width*k;c.height=i.height*k;c.getContext("2d").drawImage(i,0,0,c.width,c.height);res(c.toDataURL("image/jpeg",Q))};i.src=r.result};r.readAsDataURL(f)});
const A={go:d=>go(d.id),cat:d=>{S.f.cat=d.id;draw()},fo:()=>{S.fo=!S.fo;draw()},rf:d=>{S.f[d.id]=d.id=="subs"?"0":(d.id=="ver"||d.id=="mon")?false:"";draw()},clear:()=>{S.f={cat:"",min:"",max:"",subs:"0",ver:false,mon:false};S.q="";$("q").value="";draw()},open:d=>{S.id=d.id;go("ch")},mode:d=>{S.mode=d.id;draw()},out:async()=>{await signOut(auth);go("home")},gi:d=>{S.gi=+d.id;draw()},
bell(){const p=$("pop");p.classList.toggle("on");if(p.classList.contains("on")){pop();lss("cs_nseen",now());nav()}},
ndis(d){const a=lsg("cs_ndis",[]);a.push(d.id);lss("cs_ndis",a);nav()},fab(){$("fab").classList.toggle("on")},
qgo(){S.q=g("q");if(S.v!="home")go("home");else draw()},
theme(){const d=document.documentElement,n=d.dataset.theme=="dark"?"light":"dark";d.dataset.theme=n;lss("cs_theme",n)},
fav(d){const i=S.fav.indexOf(d.id);if(i<0){S.fav.push(d.id);T("Saved")}else{S.fav.splice(i,1);T("Removed from saved")}lss("cs_fav",S.fav);draw()},
async share(){try{await navigator.clipboard.writeText(location.href);T("Link copied")}catch{T(location.href)}},
async login(){try{await signInWithEmailAndPassword(auth,g("le"),$("lp").value);go("home")}catch(e){T(err(e))}},
async forgot(){if(!g("le"))return T("Enter your email first");try{await sendPasswordResetEmail(auth,g("le"));T("Reset email sent")}catch(e){T(err(e))}},
async signup(){const n=g("sn"),em=g("se"),p=$("sp").value;if(n.length<2)return T("Enter your name");if(p.length<8)return T("Password must be at least 8 characters");if(p!=$("sp2").value)return T("Passwords do not match");
try{const c=await createUserWithEmailAndPassword(auth,em,p);await updateProfile(c.user,{displayName:n});await setDoc(doc(db,"users",c.user.uid),{name:n,email:em.toLowerCase(),phone:g("sph"),banned:false,createdAt:now()});S.p={name:n,phone:g("sph")};go("home");T("Welcome!")}catch(e){T(err(e))}},
async saveP(){if(g("pn").length<2)return T("Enter your name");const x={name:g("pn"),phone:g("pph")};try{await updateDoc(doc(db,"users",S.u.uid),x);S.p={...S.p,...x};draw();T("Saved")}catch(e){T(err(e))}},
async sell(){if(need())return;const n=k=>+g(k)||0,u=url(g("s_url"));if(!g("s_name")||!n("s_price"))return T("Enter channel name and price");if(!/^https:\/\/((www|m)\.)?(youtube\.com|youtu\.be)\//i.test(u))return T("Enter a valid YouTube link");if(!g("s_ph")||!g("s_em"))return T("Enter your phone and email");
const fs=[...$("s_img").files].slice(0,4);if(!fs.length)return T("Add at least one screenshot");T("Uploading…");
try{let imgs=await Promise.all(fs.map(f=>comp(f,800,.6)));if(imgs.join("").length>800000)imgs=await Promise.all(fs.map(f=>comp(f,560,.45)));if(imgs.join("").length>900000)return T("Screenshots are too large. Use fewer or smaller images.");const r=doc(collection(db,"listings"));
await setDoc(r,{name:g("s_name"),url:u,cat:g("s_cat"),subs:n("s_subs"),views:n("s_views"),inc:n("s_inc"),price:n("s_price"),age:n("s_age"),mon:g("s_mon")=="1",country:g("s_co")||"—",strikes:n("s_str"),desc:g("s_desc"),imgs,ownerId:S.u.uid,status:S.set.autoLive!==false?"live":"pending",verified:false,feat:false,t:now()});
await setDoc(doc(db,"sellerinfo",r.id),{ownerId:S.u.uid,phone:g("s_ph"),email:g("s_em")});const live=S.set.autoLive!==false;go(live?"home":"orders");T(live?"Your channel is now live!":"Submitted! The admin will review it soon.")}catch(e){T(err(e))}},
async rep(d){if(need())return;const r=prompt("Reason for report?");if(!r)return;try{await addDoc(collection(db,"reports"),{lid:d.id,by:S.u.uid,reason:r.slice(0,300),t:now()});T("Thanks, we will look into it")}catch(e){T(err(e))}},
async send(d){const t=g("mi_"+d.id),l=S.mine.find(x=>x.id==d.id);if(!t||!l)return;try{await addDoc(collection(db,"inbox"),{uid:S.u.uid,lid:d.id,lname:l.name,from:"user",text:t.slice(0,1000),t:now()});$("mi_"+d.id).value=""}catch(e){T(err(e))}}};
document.addEventListener("click",e=>{const t=e.target.closest("[data-a]");if(t&&A[t.dataset.a])A[t.dataset.a](t.dataset);if(!e.target.closest("#pop,[data-a=bell]"))$("pop").classList.remove("on");if(!e.target.closest("#fab"))$("fab").classList.remove("on")});
onSnapshot(doc(db,"settings","main"),s=>{S.set={...DEF,...(s.data()||{}),links:((s.data()||{}).links)||[]};refresh()},()=>{});
onSnapshot(collection(db,"notices"),s=>{S.N=s.docs.map(d=>({id:d.id,...d.data()}));refresh()},()=>{});
onSnapshot(query(collection(db,"listings"),where("status","in",["live","sold"])),s=>{S.L=s.docs.map(d=>({id:d.id,...d.data()}));S.ld=true;refresh()},e=>{S.ld=true;T(err(e));refresh()});
let un=[];
onAuthStateChanged(auth,async u=>{un.forEach(f=>f());un=[];S.u=u;S.p=null;S.mine=[];S.M=[];
if(u){const us=await getDoc(doc(db,"users",u.uid)).catch(()=>null);S.p=us&&us.data();if(S.p&&S.p.banned){await signOut(auth);return T("Account suspended")}
un.push(onSnapshot(query(collection(db,"listings"),where("ownerId","==",u.uid)),s=>{S.mine=s.docs.map(d=>({id:d.id,...d.data()}));refresh()},()=>{}));
un.push(onSnapshot(query(collection(db,"inbox"),where("uid","==",u.uid)),s=>{S.M=s.docs.map(d=>d.data());refresh()},()=>{}))}
refresh()});
route();
